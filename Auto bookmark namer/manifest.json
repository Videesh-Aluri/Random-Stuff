{
  "manifest_version": 3,
  "name": "Auto Bookmark Namer",
  "version": "1.0",
  "description": "Automatically renames bookmarks based on page content.",
  "permissions": [
    "bookmarks",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "bookmark.js"
  },
  "action": {
    "default_title": "Auto Bookmark Namer"
  }
}